# ===== FISHY · environment variables =====
# Copy into Railway → your service → Variables (or a local .env for testing).
# Railway sets PORT automatically. Do not set it yourself.

# --- production behaviour ---
NODE_ENV=production
# 0 = never show demo data; a DexPaprika outage shows the "lake is frozen" screen instead
DEMO_FALLBACK=0

# --- your links (shown in the navbar) ---
SITE_URL=https://fishy.example.com
X_URL=https://x.com/fishy_rh
X_HANDLE=@fishy_rh
# contract address of the token; leave empty to show "COMING SOON"
TOKEN_CA=
TOKEN_SYMBOL=
# block explorer base URL; the CA links to EXPLORER_URL/address/<CA>. Leave empty for no link.
EXPLORER_URL=

# --- DexPaprika ---
DEXPAPRIKA_BASE=https://api.dexpaprika.com
# only needed on a paid plan
DEXPAPRIKA_API_KEY=
DEXPAPRIKA_API_KEY_HEADER=authorization
CHAIN=robinhood
# 1 without an API key (page 2+ needs a paid key)
POOL_PAGES=1
REFRESH_SECONDS=60

# --- Robinhood Chain RPC (SWAP TEST) ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
SWAP_TEST_POOLS=4

# --- tuning (defaults are fine) ---
MIN_LIQUIDITY=1000
TURNOVER=10
QUAKE_MIN_DROP=0.3
QUAKE_MIN_LIQUIDITY=2000

# --- new tokens panel ---
# link for the PONS button; {ca} becomes the token address. Check the real format on Pons.
PONS_TOKEN_URL=https://ponsfamily.com/launchpad/{ca}
# Flap token page format is not confirmed: open one Flap token and adjust
FLAP_TOKEN_URL=https://flap.sh/robinhood/{ca}
DEX_TOKEN_URL=https://dexpaprika.com/robinhood/token/{ca}
NEW_TOKENS_LIMIT=60

# On-chain launchpad scanner (Pons, Flap, hood.fun, ...). Uses RPC_URL; a private RPC is better if the public one limits eth_getLogs.
LAUNCHPAD_SCAN=1
LAUNCH_SCAN_MS=20000
LAUNCH_BACKFILL_BLOCKS=60000
# LAUNCHPADS_JSON=[{"key":"mypad","name":"MYPAD","addrs":["0x..."]}]
